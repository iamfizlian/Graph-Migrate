# Environment overrides — all settings can also be set via env vars.
# Format: PSTMIGRATE_<SECTION>__<FIELD> (note double underscore between section and field)

# PSTMIGRATE_AUTH__TENANT_ID=contoso.onmicrosoft.com
# PSTMIGRATE_AUTH__CLIENT_ID=00000000-0000-0000-0000-000000000000
# PSTMIGRATE_AUTH__CLIENT_SECRET=
# PSTMIGRATE_AUTH__CLIENT_CERTIFICATE_PATH=/etc/pstmigrate/cert.pem
# PSTMIGRATE_LOG_LEVEL=DEBUG
# PSTMIGRATE_MIGRATION__WORKERS_PER_MAILBOX=4
# PSTMIGRATE_MIGRATION__MAX_PARALLEL_MAILBOXES=8
